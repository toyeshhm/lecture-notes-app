.build/
.build-xcode/
.swiftpm/
DerivedData/
dist/

# Generated from project.yml by `xcodegen generate`, so a tracked copy is a
# second source of truth that goes stale silently.
*.xcodeproj/

.DS_Store
xcuserdata/

# Snapshots are generated by `make snapshots`, and all 28 of them are rewritten
# on every run — tracking the set would put 22 MB into the pack each time the UI
# moves. Only the ones the README embeds are kept, because a README with broken
# images is worse than the churn.
Snapshots/*
!Snapshots/firstrun-dark.png
!Snapshots/firstrun-light.png
!Snapshots/library-folio-dark.png
!Snapshots/library-folio-light.png
!Snapshots/reader-dark.png
!Snapshots/reader-light.png
!Snapshots/record-idle-dark.png
!Snapshots/record-live-dark.png
!Snapshots/settings-dark.png
!Snapshots/settings-light.png
